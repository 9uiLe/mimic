{
  "name": "mimic-knowledge-prototype",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": { "bun": ">=1.4.2" },
  "scripts": {
    "build:prototype": "bun scripts/build-knowledge.ts",
    "check:prototype": "bun scripts/build-knowledge.ts --check",
    "build:research-prototype": "bun scripts/build-knowledge.ts --source prototypes/decision-material-selection/draft.md --out-dir prototypes/decision-material-selection/research",
    "check:research-prototype": "bun scripts/build-knowledge.ts --source prototypes/decision-material-selection/draft.md --out-dir prototypes/decision-material-selection/research --check",
    "build:pages": "bun run build:prototype && bun run build:research-prototype && bun scripts/build-pages.ts",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun test ./tests/*.test.ts",
    "verify": "bun run typecheck && bun run check:prototype && bun run check:research-prototype && bun run test"
  },
  "dependencies": { "marked": "17.0.5" },
  "devDependencies": { "@types/bun": "1.4.2", "typescript": "7.0.2" }
}
