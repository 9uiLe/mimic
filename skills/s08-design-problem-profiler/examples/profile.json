    "summary": "A team coordinates one incident across accountable handoffs.",
    "traits": [
      "Several roles hand off time-sensitive work on one incident.",
      "Actions must retain an accountable sequence."
    ],
    "principles": [
      "Make current ownership and next action visible.",
      "Confirm and explain state transitions."
    ],
    "risks": [
