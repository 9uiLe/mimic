      "content": {
        "summary": "Comparison semantics candidate for the comparison task.",
        "assetKind": "dtcg-tokens",
        "name": "Comparison semantics",
        "definition": {
          "tokens": {
            "primitive": {
              "color": {
                "$type": "color",
                "evidence-ink": {
                  "$value": {
                    "colorSpace": "srgb",
                    "components": [0.0862745, 0.1960784, 0.3098039]
                  }
                },
                "uncertainty-amber": {
                  "$value": {
                    "colorSpace": "srgb",
                    "components": [0.5490196, 0.3529412, 0.0862745]
                  }
                }
              },
              "space": {
                "section": {
                  "$type": "dimension",
                  "$value": { "value": 1, "unit": "rem" }
                }
              }
            },
            "semantic": {
              "color": {
                "$type": "color",
                "evidence": { "$value": "{primitive.color.evidence-ink}" },
                "uncertain": { "$value": "{primitive.color.uncertainty-amber}" }
              }
            },
            "component": {
              "comparison": {
                "evidence-border": {
                  "$type": "color",
                  "$value": "{semantic.color.evidence}"
                },
                "section-gap": {
                  "$type": "dimension",
                  "$value": "{primitive.space.section}"
                }
              }
            }
          },
          "references": ["semantic.color.evidence", "primitive.space.section"],
          "modes": ["light"]
        },
        "usageRules": ["Use as source token semantics"],
        "antiUsageRules": ["Do not treat as compiled CSS"]
      }
    },
