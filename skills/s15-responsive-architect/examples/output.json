    "content": {
      "summary": "Narrow comparison transformation candidate for the comparison task.",
      "assetKind": "responsive-rule",
      "name": "Narrow comparison transformation",
      "definition": {
        "primaryGoal": "Compare plans and decide or defer",
        "constraints": ["narrow viewport", "touch input", "long criteria"],
        "actions": [
          {
            "action": "preserve",
            "target": "criterion labels",
            "reason": "Maintain comparison meaning"
          },
          {
            "action": "reorder",
            "target": "evidence before decision",
            "reason": "Keep reading order meaningful"
          },
          {
            "action": "collapse",
            "target": "supporting details",
            "reason": "Reduce load while keeping access"
          },
          {
            "action": "hide",
            "target": "decorative illustration",
            "reason": "No task meaning"
          },
          {
            "action": "replace",
            "target": "side-by-side grid with criterion sequence",
            "reason": "Retain candidate association"
          },
          {
            "action": "split",
            "target": "long criteria into steps",
            "reason": "Maintain focus and progress"
          },
          {
            "action": "progressive-disclose",
            "target": "secondary evidence",
            "reason": "Preserve discoverability without crowding"
          }
        ],
        "parityCheck": {
          "desktop": "Compare plans and decide or defer",
          "mobile": "Compare plans and decide or defer",
          "status": "UNVERIFIED"
        },
        "failureModes": ["Hidden candidate identity or uncertainty"]
      },
      "usageRules": [
        "Use when side-by-side comparison cannot fit without lost meaning"
      ],
      "antiUsageRules": [
        "Do not hide primary action, candidate identity or uncertainty"
      ]
    }
  },
