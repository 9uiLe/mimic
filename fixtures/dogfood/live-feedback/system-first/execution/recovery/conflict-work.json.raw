        "type": "system-request",
        "schemaVersion": "1.0.0",
        "revision": 1,
        "title": "Clarify or provide selected-order pre-assignment data freshness",
        "createdAt": "2026-10-07T14:02:19.689286Z"
      },
      "scope": {
        "level": "organization",
