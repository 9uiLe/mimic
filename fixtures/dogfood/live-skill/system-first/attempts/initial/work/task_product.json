      "content": {
        "summary": "Proposed synthetic repair-desk interface for a dispatcher to inspect one public water-leak work order before assigning a crew. The brief establishes a design task, not validated demand or a deployed product.",
        "vision": "Let a dispatcher carry the identity and relevant urgency cues of one work order from the queue into its detail before a consequential crew assignment.",
        "goals": [
          "Show the work-order ID, severity, and age before the dispatcher reaches the assignment action.",
          "Preserve the exact work-order ID between list and detail so the dispatcher can confirm which order is being inspected.",
          "Keep any proposed interface behavior distinguishable from the constructed list/detail/assignment inventory."
        ],
        "nonGoals": [
          "Claim market demand, field research, or a deployed Riverbend backend.",
          "Introduce multi-order comparison or bulk assignment as an approved product requirement.",
          "Treat an interface proposal as authorization to change backend behavior or to assign a real crew."
        ]
      }
    }
