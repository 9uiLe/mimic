{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mimic:artifact:v1:type:decision",
  "title": "decision",
  "allOf": [
    {
      "$ref": "urn:mimic:artifact:v1:common"
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "properties": {
            "type": {
              "const": "decision"
            }
          },
          "type": "object"
        },
        "content": {
          "type": "object",
          "required": ["summary", "question", "alternatives", "outcome"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "outcome": {
              "enum": ["open", "proposed", "committed"]
            },
            "chosenAlternative": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "committed"
                  }
                },
                "type": "object"
              },
              "then": {
                "required": ["chosenAlternative", "rationale"],
                "type": "object",
                "properties": {
                  "chosenAlternative": {},
                  "rationale": {}
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "content": {
            "properties": {
              "outcome": {
                "const": "committed"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
