{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mimic:artifact:v1:type:brand",
  "title": "brand",
  "allOf": [
    {
      "$ref": "urn:mimic:artifact:v1:common"
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "properties": {
            "type": {
              "const": "brand"
            }
          },
          "type": "object"
        },
        "content": {
          "type": "object",
          "required": ["summary", "attributes", "voice", "visualIntent"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "attributes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "voice": {
              "type": "string",
              "minLength": 1
            },
            "visualIntent": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
