{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mimic:artifact:v1:type:design-direction",
  "title": "design-direction",
  "allOf": [
    {
      "$ref": "urn:mimic:artifact:v1:common"
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "properties": {
            "type": {
              "const": "design-direction"
            }
          },
          "type": "object"
        },
        "content": {
          "type": "object",
          "required": [
            "summary",
            "principles",
            "mechanisms",
            "selectionStatus"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "principles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "mechanisms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "selectionStatus": {
              "enum": ["candidate", "proposed-selection", "selected"]
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "selectionStatus": {
                    "const": "selected"
                  }
                },
                "type": "object"
              },
              "then": {
                "$comment": "A selected direction requires human approval in the envelope."
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "content": {
            "properties": {
              "selectionStatus": {
                "const": "selected"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
