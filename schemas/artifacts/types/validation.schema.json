{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mimic:artifact:v1:type:validation",
  "title": "validation",
  "allOf": [
    {
      "$ref": "urn:mimic:artifact:v1:common"
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "properties": {
            "type": {
              "const": "validation"
            }
          },
          "type": "object"
        },
        "content": {
          "type": "object",
          "required": [
            "summary",
            "target",
            "method",
            "state",
            "evidenceRefs"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "PASS",
                "CONCERN",
                "FAIL",
                "UNVERIFIED",
                "N/A"
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "PASS",
                      "CONCERN",
                      "FAIL"
                    ]
                  }
                },
                "type": "object"
              },
              "then": {
                "properties": {
                  "evidenceRefs": {
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "type": "object"
              }
            }
          ]
        }
      }
    }
  ]
}
