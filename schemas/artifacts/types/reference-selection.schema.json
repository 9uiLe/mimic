{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mimic:artifact:v1:type:reference-selection",
  "title": "reference-selection",
  "allOf": [
    {
      "$ref": "urn:mimic:artifact:v1:common"
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "properties": {
            "type": {
              "const": "reference-selection"
            }
          },
          "type": "object"
        },
        "content": {
          "type": "object",
          "required": ["summary", "references"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "reference",
                  "classification",
                  "structuralRelevance",
                  "contextDistance",
                  "transferableMechanisms"
                ],
                "properties": {
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "classification": {
                    "enum": [
                      "near",
                      "adjacent",
                      "far",
                      "wildcard",
                      "anti-reference"
                    ]
                  },
                  "structuralRelevance": {
                    "enum": ["low", "medium", "high"]
                  },
                  "contextDistance": {
                    "enum": ["low", "medium", "high"]
                  },
                  "transferableMechanisms": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "classification": {
                          "const": "far"
                        }
                      },
                      "required": ["classification"],
                      "type": "object"
                    },
                    "then": {
                      "properties": {
                        "structuralRelevance": {
                          "const": "high"
                        },
                        "contextDistance": {
                          "const": "high"
                        }
                      },
                      "type": "object"
                    }
                  }
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
