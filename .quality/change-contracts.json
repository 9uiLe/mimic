{
  "schema_version": 1,
  "contracts": [
    {
      "id": "repository-quality-policy",
      "paths": [
        "scripts/quality/*",
        "tests/quality_*",
        ".githooks/*",
        ".quality/*",
        ".github/workflows/*",
        "package.json",
        "flake.nix"
      ],
      "purpose": "変更候補の長さ・限定した禁止名・基準の緩和を、確定済みの版と比較して検査する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/quality-checks.md#確定した検査条件"
      ],
      "validation": [
        "bun run quality:test",
        "bun run quality:check",
        "bun run quality:staged"
      ],
      "unresolved": [
        "名前の意味、仕様の妥当性、検査コード自体の変更の妥当性は人のレビューが必要。"
      ]
    },
    {
      "id": "knowledge-link-destination",
      "paths": [
        "scripts/knowledge-paths.ts",
        "scripts/build-knowledge.ts",
        "tests/knowledge-paths.test.ts",
        "tests/knowledge-output.test.ts"
      ],
      "purpose": "出力先から編集元と同じ概念の入口へ届く相対リンクを保つ。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/development.md#生成の規則",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun scripts/quality/verify-behavior.ts --case knowledge-relative-link",
        "bun run verify"
      ],
      "unresolved": [
        "この具体例は概念の意味やWindows対応の保証ではない。"
      ]
    },
    {
      "id": "knowledge-source-metadata",
      "paths": [
        "scripts/build-knowledge.ts",
        "tests/knowledge-output.test.ts",
        "tests/pages-output.test.ts"
      ],
      "purpose": "知識の状態項目を廃止し、正本の版・対象範囲・出典と生成物の原文対応を保持する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/knowledge-structure.md#メタデータ",
        "guideline/knowledge-view.md#編集元と生成",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun scripts/quality/verify-behavior.ts --case knowledge-source-metadata",
        "bun scripts/quality/verify-behavior.ts --case pages-source-provenance",
        "bun run verify"
      ],
      "unresolved": [
        "知識の原典への忠実さは、この表示・配信テストの保証範囲に含めない。"
      ]
    },
    {
      "id": "pages-knowledge-reader",
      "paths": [
        "scripts/build-pages.ts",
        "scripts/build-guideline.ts",
        "scripts/pages-catalog.ts",
        "scripts/knowledge-view.css",
        "knowledge/interaction-design/examples/recording-app-layout.svg",
        "tests/pages-output.test.ts",
        "tests/pages-catalog.test.ts",
        "tests/guideline-output.test.ts"
      ],
      "purpose": "全24概念への入口と、正本の内容・版を保つ本文／関連概念／出典／例のHTML読書経路、原文のバイト列を保つ静的画面図への参照を用意する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/knowledge-view.md#Pagesの読書経路",
        "guideline/development.md#GitHub Pagesへの公開",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun run build:pages",
        "bun run verify",
        "bun run test:effectiveness",
        "実ブラウザで一覧・本文・関連・例・出典と狭幅・キーボード操作を確認する。"
      ],
      "unresolved": [
        "使いやすさや知識の原典への忠実さ、画面全体のアクセシビリティ適合を機械検査だけでは保証しない。",
        "公開は許可後のmain反映まで実施しない。"
      ]
    },
    {
      "id": "pages-pinned-font-assets",
      "paths": [
        "assets/fonts/gen-interface-jp/0.8.0/*",
        "package.json",
        "bun.lock",
        "scripts/pages-fonts.ts",
        "scripts/build-pages.ts",
        "scripts/build-guideline.ts",
        "scripts/build-knowledge.ts",
        "scripts/pages-catalog.ts",
        "tests/pages-output.test.ts"
      ],
      "purpose": "Pagesの読書HTMLだけで固定版のGen Interface JP本文400・見出し600を同一成果物から読み、配布ファイルをハッシュで照合する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/knowledge-view.md#編集元と生成",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun run build:pages",
        "bun run verify",
        "bun scripts/quality/verify-behavior.ts --case pages-pinned-fonts",
        "bun scripts/quality/verify-behavior.ts --case pages-font-corruption"
      ],
      "unresolved": [
        "実ブラウザの字形・折返し・拡大表示と実転送量は別に確認する。",
        "公開は許可後のmain反映まで実施しない。"
      ]
    },
    {
      "id": "knowledge-explanatory-images",
      "paths": [
        "scripts/knowledge-images.ts",
        "scripts/pages-fonts.ts",
        "tests/knowledge-images.test.ts",
        "knowledge/alignment-and-grids/examples/*.svg",
        "knowledge/color-context/examples/*.svg",
        "knowledge/interaction-design/examples/*.svg"
      ],
      "purpose": "正本MarkdownとPagesから、説明文と代替テキストを伴う明示した自己完結SVGへ到達できるようにする。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/knowledge-view.md#説明図と画像",
        "guideline/knowledge-structure.md#固定の入口と補足",
        "guideline/development.md#生成の規則"
      ],
      "validation": [
        "bun run build:pages",
        "bun run verify",
        "bun run test:effectiveness",
        "実ブラウザで説明図の表示と全体表示リンク、狭幅での配置を確認する。"
      ],
      "unresolved": [
        "画像の理解しやすさ、知識の正しさ、全体のアクセシビリティ適合は生成と配信の検査では保証しない。"
      ]
    },
    {
      "id": "knowledge-semantic-relations",
      "paths": [
        "relations/*.json",
        "scripts/relations.ts",
        "scripts/build-relation-graph.ts",
        "web/graph.js",
        "web/graph.css",
        "tests/relations.test.ts",
        "tests/relation-graph-output.test.ts"
      ],
      "purpose": "根拠付きの意味関係を本文から独立して索引し、Pagesで方向・範囲を保ってグラフと文章で読む。",
      "basis_status": "confirmed",
      "basis": [
        "relations/README.md#正本と役割",
        "relations/README.md#更新する",
        "guideline/knowledge-view.md#関係グラフの表示"
      ],
      "validation": [
        "bun run relations:check",
        "bun run verify",
        "bun run quality:check",
        "bun run quality:test",
        "bun run test:effectiveness",
        "ブラウザで知識の選択・URLと履歴・根拠と本文の往復・狭幅・キーボードを確認する。"
      ],
      "unresolved": [
        "関係の原典妥当性とAIの理解改善は、構造・生成検査の成功だけでは保証しない。"
      ]
    },
    {
      "id": "pages-reading-design-system",
      "paths": [
        "design/*",
        "scripts/design-tokens.ts",
        "scripts/design-specimens.ts",
        "scripts/pages-design.ts",
        "web/reading.*",
        "tests/pages-design.test.ts",
        "tests/design-specimens.test.ts"
      ],
      "purpose": "本文と公開URLを保ちながら、疑問から知識を探す共通UIとTokenの編集・変換・検証を管理する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/design-system.md",
        "guideline/knowledge-view.md#Pagesの読書経路",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun run typecheck",
        "bun test ./tests/pages-design.test.ts ./tests/design-specimens.test.ts ./tests/pages-output.test.ts",
        "bun run test:effectiveness",
        "実ブラウザで疑問・本文・出典・選択関係・根拠・戻り先と狭幅/文字拡大を確認する。"
      ],
      "unresolved": [
        "使いやすさと実際の読み上げ、知識の原典妥当性は自動検査だけでは保証しない。",
        "公開は利用者の確認と許可後に実施する。"
      ]
    }
  ]
}
