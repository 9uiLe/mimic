{
  "schema_version": 1,
  "contracts": [
    {
      "id": "repository-quality-policy",
      "paths": [
        "scripts/quality/*",
        "tests/quality_*",
        ".githooks/*",
        ".quality/*",
        ".github/workflows/*",
        "package.json",
        "flake.nix"
      ],
      "purpose": "変更候補の長さ・限定した禁止名・基準の緩和を、確定済みの版と比較して検査する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/quality-checks.md#確定した検査条件"
      ],
      "validation": [
        "bun run quality:test",
        "bun run quality:check",
        "bun run quality:staged"
      ],
      "unresolved": [
        "名前の意味、仕様の妥当性、検査コード自体の変更の妥当性は人のレビューが必要。"
      ]
    },
    {
      "id": "knowledge-link-destination",
      "paths": [
        "scripts/knowledge-paths.ts",
        "scripts/build-knowledge.ts",
        "tests/knowledge-paths.test.ts",
        "tests/knowledge-output.test.ts"
      ],
      "purpose": "出力先から編集元と同じ概念の入口へ届く相対リンクを保つ。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/development.md#生成の規則",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun scripts/quality/verify-behavior.ts --case knowledge-relative-link",
        "bun run verify"
      ],
      "unresolved": [
        "この具体例は概念の意味やWindows対応の保証ではない。"
      ]
    },
    {
      "id": "knowledge-source-metadata",
      "paths": [
        "scripts/build-knowledge.ts",
        "tests/knowledge-output.test.ts",
        "tests/pages-output.test.ts"
      ],
      "purpose": "知識の状態項目を廃止し、正本の版・対象範囲・出典と生成物の原文対応を保持する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/knowledge-structure.md#メタデータ",
        "guideline/knowledge-view.md#編集元と生成",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun scripts/quality/verify-behavior.ts --case knowledge-source-metadata",
        "bun scripts/quality/verify-behavior.ts --case pages-source-provenance",
        "bun run verify"
      ],
      "unresolved": [
        "知識の原典への忠実さは、この表示・配信テストの保証範囲に含めない。"
      ]
    },
    {
      "id": "pages-knowledge-reader",
      "paths": [
        "scripts/build-pages.ts",
        "scripts/build-guideline.ts",
        "scripts/pages-catalog.ts",
        "scripts/knowledge-view.css",
        "tests/pages-output.test.ts",
        "tests/pages-catalog.test.ts",
        "tests/guideline-output.test.ts"
      ],
      "purpose": "全12概念への入口と、正本の内容・版を保つ本文／関連概念／出典／例のHTML読書経路を用意する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/knowledge-view.md#Pagesの読書経路",
        "guideline/development.md#GitHub Pagesへの公開",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun run build:pages",
        "bun run verify",
        "bun run test:effectiveness",
        "実ブラウザで一覧・本文・関連・例・出典と狭幅・キーボード操作を確認する。"
      ],
      "unresolved": [
        "使いやすさや知識の原典への忠実さ、画面全体のアクセシビリティ適合を機械検査だけでは保証しない。",
        "公開は許可後のmain反映まで実施しない。"
      ]
    },
    {
      "id": "pages-pinned-font-assets",
      "paths": [
        "assets/fonts/gen-interface-jp/0.8.0/*",
        "package.json",
        "bun.lock",
        "scripts/pages-fonts.ts",
        "scripts/build-pages.ts",
        "scripts/build-guideline.ts",
        "scripts/build-knowledge.ts",
        "scripts/pages-catalog.ts",
        "tests/pages-output.test.ts"
      ],
      "purpose": "Pagesの読書HTMLだけで固定版のGen Interface JP本文400・見出し600を同一成果物から読み、配布ファイルをハッシュで照合する。",
      "basis_status": "confirmed",
      "basis": [
        "guideline/knowledge-view.md#編集元と生成",
        ".quality/behavior-cases.json"
      ],
      "validation": [
        "bun run build:pages",
        "bun run verify",
        "bun scripts/quality/verify-behavior.ts --case pages-pinned-fonts",
        "bun scripts/quality/verify-behavior.ts --case pages-font-corruption"
      ],
      "unresolved": [
        "実ブラウザの字形・折返し・拡大表示と実転送量は別に確認する。",
        "公開は許可後のmain反映まで実施しない。"
      ]
    }
  ]
}
