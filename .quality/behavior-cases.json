        "knowledge/visual-hierarchy/examples/schedule.md"
      ],
      "testName": "artifact copies match their generated or canonical sources and retain repository-relative provenance",
      "mutation": {
        "description": "コピーするHTMLのaccepted原値だけをproposedへ誤変換し、配信物を生成済み原文と異なる採用状態にする。",
        "find": "for (const file of copiedFiles) outputs.set(file, await readSource(file));",
        "replace": "for (const file of copiedFiles) outputs.set(file, Buffer.from((await readSource(file)).toString().replace('status</dt><dd>accepted', 'status</dt><dd>proposed')));",
        "assertionMessage": "prototypes/decision-material-selection/index.html"
      }
    },
