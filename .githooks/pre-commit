#!/usr/bin/env python3
"""Versioned, inspection-only pre-commit entry; all implementation comes from the index."""

from pathlib import Path
import subprocess
import sys
import tempfile


def main():
    script_path = "scripts/quality/index_snapshot.py"
    result = subprocess.run(
        ["git", "show", f":{script_path}"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
    )
    if result.returncode:
        print(f"quality hook: required staged file is unavailable: {script_path}", file=sys.stderr)
        return 2
    with tempfile.TemporaryDirectory(prefix="mimic-quality-hook-") as temporary:
        launcher = Path(temporary) / "index_snapshot.py"
        launcher.write_bytes(result.stdout)
        repository = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], stdout=subprocess.PIPE, check=True
        ).stdout.decode(errors="surrogateescape").removesuffix("\n")
        return subprocess.run(
            [sys.executable, str(launcher), "--repository", repository, "--mode", "staged"],
            check=False,
        ).returncode


try:
    raise SystemExit(main())
except KeyboardInterrupt:
    print("quality hook: interrupted; worktree and index were not changed", file=sys.stderr)
    raise SystemExit(130)
except (OSError, subprocess.SubprocessError) as error:
    print(f"quality hook: {error}", file=sys.stderr)
    raise SystemExit(2)
